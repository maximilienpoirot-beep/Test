# Copie ce fichier en .env et remplis-le. Ne commite JAMAIS le .env.

# --- Mode ---------------------------------------------------------------
# paper = argent fictif (aucun ordre envoyé), live = ordres réels
MODE=paper

# --- Exchange (nom ccxt : binance, kraken, bybit, okx, coinbase...) -----
EXCHANGE=binance
# Inutiles en mode paper. En live : clé avec droit de trading, SANS droit de retrait.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# true = testnet de l'exchange (s'il existe)
EXCHANGE_SANDBOX=false

# --- Marchés ------------------------------------------------------------
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=15m
# Fréquence de vérification (secondes) : nouvelles bougies + stop-loss/objectifs
SCAN_INTERVAL=30

# --- Stratégie ----------------------------------------------------------
EMA_FAST=9
EMA_SLOW=21
EMA_TREND=50
ADX_PERIOD=14
ADX_MIN=20
VOLUME_MULT=1.2
ATR_PERIOD=14
# Stop-loss initial, en multiples d'ATR
SL_ATR=1.5
# Le stop passe au prix d'entrée quand le gain atteint X fois le risque (0 = désactivé)
BREAKEVEN_R=1.0
# Puis il suit le plus haut à X ATR de distance (0 = désactivé). Pas d'objectif fixe.
TRAIL_ATR=2.5
# Ignore les signaux dont le risque (distance au stop) vaut moins de X fois les frais aller-retour
MIN_RISK_FEE_MULT=2.5
# Ventes à découvert (mode paper uniquement)
ALLOW_SHORT=false

# --- Risque -------------------------------------------------------------
PAPER_BALANCE=1000
# Perte max si le stop est touché, en % du capital
RISK_PER_TRADE_PCT=1
MAX_POSITION_USDT=200
MAX_OPEN_POSITIONS=3
# Au-delà, plus aucune alerte jusqu'au lendemain (UTC)
MAX_DAILY_LOSS_USDT=50
# Frais par ordre, en % (0.1 = 0,1 % à l'achat et 0,1 % à la vente)
FEE_PCT=0.1
# En live : pose le stop-loss directement sur l'exchange (recommandé)
EXCHANGE_STOPS=true
# Déplace le stop sur l'exchange seulement s'il a bougé d'au moins X ATR (évite de spammer l'API)
STOP_UPDATE_ATR=0.25

# --- Alertes ------------------------------------------------------------
# Durée de validité d'une alerte (secondes)
ALERT_TTL=180
# Refuse l'exécution si le prix a déjà bougé de plus de X % dans le sens du trade
MAX_SLIPPAGE_PCT=0.3

# --- Telegram -----------------------------------------------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Claude -------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-opus-5-5

# --- Bot survivant (survivor_bot.py) -------------------------------------
# Utilise TELEGRAM_TOKEN et TELEGRAM_CHAT_ID ci-dessus. Pour le faire tourner en même temps
# que bot.py, crée un 2e bot avec @BotFather et mets son token ici.
SURVIVOR_TELEGRAM_TOKEN=
SURVIVOR_MODE=paper
SURVIVOR_STATE_FILE=data/survivor.json
# Fréquence de surveillance des prix (secondes)
SURVIVOR_SCAN_SECONDS=300
# Heure du bilan quotidien (heure de Paris)
SURVIVOR_REPORT_TIME=20:00
